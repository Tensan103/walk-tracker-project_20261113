# Walk Tracker — copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this .env.example file is tracked instead.

# API Gateway base URL (no trailing slash)
VITE_API_URL=https://your-api-id.execute-api.ap-northeast-1.amazonaws.com/prod

# Cognito User Pool (admin dashboard authentication)
VITE_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
