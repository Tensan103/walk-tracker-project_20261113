# Walk Tracker — root env file (auto-generated by scripts/sync-env.sh after cdk deploy).
# Copy this file to .env and fill in real values, or just run ./scripts/sync-env.sh.
# .env is git-ignored; this .env.example file is tracked instead.

# API Gateway base URL (no trailing slash)
API_URL=https://your-api-id.execute-api.ap-northeast-1.amazonaws.com/prod

# API Gateway API key (Android app authentication)
API_KEY=your-api-key-value-here

# Cognito User Pool (admin dashboard authentication)
USER_POOL_ID=ap-northeast-1_xxxxxxxxx
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# S3 + CloudFront (admin web hosting)
WEB_BUCKET_NAME=backendstack-viewerappbucket-xxxxxxxxxxxx
CLOUDFRONT_DISTRIBUTION_ID=XXXXXXXXXXXXX
WEB_URL=https://xxxxxxxxxxxx.cloudfront.net
