# Walk Tracker backend — copy this file to .env and fill in real values.
# .env is git-ignored; this .env.example file is tracked instead.

# API Gateway base URL (no trailing slash) — used by Makefile test targets
API_URL=https://your-api-id.execute-api.ap-northeast-1.amazonaws.com/prod

# Default device ID for Makefile test-post
DEVICE_ID=test-device-001

# API Gateway API key (Android app authentication)
API_KEY=your-api-key-value-here

# Cognito User Pool (admin dashboard authentication)
USER_POOL_ID=ap-northeast-1_xxxxxxxxx
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
